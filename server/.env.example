# Copy this file to server/.env and fill in ONE provider.
# Leave LLM_PROVIDER blank to auto-detect from whichever key is set.

# ── Groq (free tier, fast; 8k tokens/minute on free plan) ──
LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# ── Claude (best quality; 1M context, no tight per-minute cap) ──
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5

# ── Gemini (free tier with a large per-minute quota) ──
# LLM_PROVIDER=google_genai
# GOOGLE_API_KEY=
# LLM_MODEL=gemini-2.5-flash

# ── Ollama (fully offline; install from ollama.com, then `ollama pull llama3.1:8b`) ──
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1:8b

# Optional tuning
# EMBED_MODEL=BAAI/bge-small-en-v1.5
# CHUNK_CHARS=1100
# WATCH_INTERVAL_SEC=15
